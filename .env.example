# Cadencia · variables de entorno
#
# Copia este archivo a `.env` y rellena los valores. `.env` NO se sube al repo:
# lleva la contraseña de la base y la llave de servicio de Supabase.
#
# En Vercel casi todas las inyecta sola la integración con Supabase; los nombres
# de aquí son exactamente ésos, para que local y producción lean lo mismo.

# --- Base de datos (Supabase / Postgres) ---------------------------------
#
# POOLER (puerto 6543). Es la que usa la app: en serverless cada invocación
# abre su conexión y sin pooler se agotan las de Postgres. `pgbouncer=true`
# desactiva los prepared statements, que el pooler en modo transacción no
# soporta.
POSTGRES_PRISMA_URL="postgres://postgres.TU_REF:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"

# DIRECTA (puerto 5432). Sólo `prisma db push` y las migraciones, que
# necesitan una sesión real.
POSTGRES_URL_NON_POOLING="postgres://postgres.TU_REF:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require"

# --- Sesión ---------------------------------------------------------------
# Firma la cookie de sesión. En producción NO tiene valor por defecto: si falta,
# la app no emite sesiones. Si lo cambias, se cierran todas las abiertas.
#   openssl rand -base64 48
SESSION_SECRET="cambia-esto-por-algo-largo-y-aleatorio"

# --- Comprobantes de ausencias -------------------------------------------
# Bucket PRIVADO de Supabase Storage. Si faltan, la app simplemente no ofrece
# adjuntar comprobantes; todo lo demás sigue funcionando.
NEXT_PUBLIC_SUPABASE_URL="https://TU_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key"

# --- Zona horaria ---------------------------------------------------------
APP_TIMEZONE="America/Mexico_City"
