# Cadencia · variables de entorno
#
# Copia este archivo a `.env` y rellena los valores. `.env` NO se sube al repo:
# contiene la contraseña de la base y la llave de servicio de Supabase.

# --- Base de datos (Supabase / Postgres) ---------------------------------
#
# DATABASE_URL es el POOLER (puerto 6543). Es la que usa la app: en serverless
# cada invocación abre conexión y sin pooler se agota la base.
# Los parámetros no son opcionales: pgbouncer=true desactiva los prepared
# statements (que el pooler en modo transacción no soporta) y
# connection_limit=1 evita que cada función acapare conexiones.
DATABASE_URL="postgresql://postgres.TU_REF:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL es la conexión DIRECTA (puerto 5432). Sólo la usan `prisma db push`
# y las migraciones, que necesitan una sesión real.
DIRECT_URL="postgresql://postgres.TU_REF:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# --- Sesión ---------------------------------------------------------------
# Firma la cookie de sesión. En producción tiene que ser un valor largo y
# aleatorio; si cambia, todas las sesiones abiertas se invalidan.
SESSION_SECRET="cambia-esto-por-algo-largo-y-aleatorio"

# --- Almacenamiento de comprobantes --------------------------------------
# Bucket PRIVADO de Supabase Storage donde viven los adjuntos de ausencias.
# La service_role key es secreta: sólo se usa en el servidor.
SUPABASE_URL="https://TU_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key"

# --- Zona horaria ---------------------------------------------------------
APP_TIMEZONE="America/Mexico_City"
