{
  "name": "cadencia",
  "version": "1.0.0",
  "private": true,
  "description": "Cadencia — agenda digital de ejecutivos. By Forja Estudio.",
  "scripts": {
    "predev": "prisma generate && prisma db push --skip-generate",
    "dev": "next dev",
    "build": "prisma generate && prisma db push --skip-generate && next build",
    "start": "next start",
    "seed": "prisma db push --skip-generate && tsx prisma/seed.ts",
    "db:reset": "rm -f prisma/dev.db prisma/dev.db-journal && prisma db push --skip-generate && tsx prisma/seed.ts",
    "test:recurrencia": "tsx pruebas/recurrencia.ts",
    "test:recordatorios": "tsx pruebas/recordatorios.ts",
    "test:ausencias": "tsx pruebas/ausencias.ts",
    "test:agenda": "tsx pruebas/agenda.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "chrono-node": "^2.7.7",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "rrule": "^2.8.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.11",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
